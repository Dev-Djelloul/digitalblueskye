{
    "git.ignoreLimitWarning": true,
    "liveServer.settings.port": 5501,
    "files.autoSave": "afterDelay",
    "editor.linkedEditing": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.stylelint": "explicit"
    },
    "stylelint.enable": true,
    "stylelint.validate": [
        "css",
        "scss",
        "less"
    ]
}